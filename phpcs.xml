<?xml version="1.0"?>
<ruleset name="SpacedTracker">
    <description>PSR-12 for this package.</description>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <file>src</file>
    <file>tests</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <!--
        PSR-12's 120-character line is a soft limit. Space-Track field names,
        request URLs, and fixture rows cross it. The hard PSR-12 rules stay on.
    -->
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
</ruleset>

