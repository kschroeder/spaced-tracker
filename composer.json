{
    "name": "kschroeder/spaced-tracker",
    "description": "Framework-agnostic PHP client for every Space-Track.org API controller and request class.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": ["space-track", "satellites", "tle", "omm", "psr-18", "spacetrack"],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "amphp/amp": "^3.0",
        "amphp/http-client": "^5.0",
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11",
        "symfony/http-client": "^7.1 || ^8.0"
    },
    "suggest": {
        "amphp/http-client": "Opt-in Amp concurrent transport",
        "guzzlehttp/guzzle": "Alternative PSR-18 client with promise-based batches",
        "monolog/monolog": "PSR-3 logger. The client wraps it so secrets are redacted.",
        "nyholm/psr7": "PSR-7 messages and PSR-17 factories used by ClientBuilder",
        "symfony/http-client": "Recommended PSR-18 client. Enables multiplexed batches."
    },
    "autoload": {
        "psr-4": {
            "SpacedTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SpacedTracker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "stan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    }
}
